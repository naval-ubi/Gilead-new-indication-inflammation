APP_ENV=dev
DATABASE_URL=sqlite:///./gilead.db
# PostgreSQL (docker compose up -d db; move SQLite data with: python -m app.db.sqlite_to_postgres --target <url>)
# DATABASE_URL=postgresql+psycopg://gilead:gilead@localhost:5432/gilead
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_DEMO_DATA=true
# Sample activity for frontend testing (searches, reports, saved and shared items, scoring). Turn off in shared/prod environments.
SEED_SAMPLE_DATA=true
# AI Scientific Search service (AWS API Gateway). Ask the AI team for the base URL; keep it out of git
# (the service has no API key). Required for AI content: when empty, research runs fail with "not configured" and
# AI Rephrase returns 503. Sample data never calls the service.
AI_SEARCH_BASE_URL=
AI_SEARCH_TIMEOUT_SECONDS=90

# ---- AWS (see README "Deploying to AWS Lambda"). Not needed locally.
# APP_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>   # JSON {"JWT_SECRET": ..., "AI_SEARCH_BASE_URL": ...}
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<rds-secret>   # used when DATABASE_URL is not set
# DB_HOST=<rds-endpoint>
# DB_NAME=gilead
# DB_SSLMODE=require
# RUN_DISPATCH=auto            # inline | lambda | auto (lambda when running on AWS Lambda)
# WORKER_FUNCTION_NAME=        # empty = the API function runs research itself
